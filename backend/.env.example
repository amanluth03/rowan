# Copy to .env for local dev. Values here match backend/docker-compose.yml's
# local Postgres — never real credentials. Production values (Supabase DSN,
# Resend key, kill switch) live in Vercel/host env per CLAUDE.md secrets policy,
# never in a committed file.

DATABASE_URL=postgresql://rowan_app:rowan_app_dev_password@localhost:55432/rowan
SYSTEM_DATABASE_URL=postgresql://rowan_system:rowan_system_dev_password@localhost:55432/rowan

# Admin/superuser DSN — used ONLY by scripts/migrate.py, never request-path code.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/rowan
ROWAN_APP_DB_PASSWORD=rowan_app_dev_password
ROWAN_SYSTEM_DB_PASSWORD=rowan_system_dev_password

# Global kill switch (CLAUDE.md guardrail) — halts all outbound tool actions.
ROWAN_KILL_SWITCH=false

# Resend (send-only credential). Empty in dev -> send_email simulates a send.
RESEND_API_KEY=
RESEND_FROM_EMAIL=rowan@example.com
RESEND_WEBHOOK_SECRET=dev_webhook_secret_change_me

# Claude API (agent-engineer: app/tools/extraction_engine.py,
# app/tools/explanation_engine.py). Empty in dev -> ClaudeExtractionEngine
# fails closed at construction; run_parsing has no engine to fall back to.
# ClaudeExplanationEngine similarly fails closed, but that path degrades
# gracefully (deterministic summary) since drafting is best-effort.
ANTHROPIC_API_KEY=
CLAUDE_CLASSIFY_MODEL=claude-haiku-4-5
CLAUDE_EXTRACT_MODEL=claude-sonnet-5
CLAUDE_EXPLAIN_MODEL=claude-haiku-4-5

# --- Supabase Auth (Epic 1) ---
# Project base URL. Required in every environment; empty => auth fails closed.
SUPABASE_URL=
# Optional override, used by tests to point at a fake in-process JWKS.
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Public base URL of the Rowan web app (used in invite links).
APP_BASE_URL=http://localhost:3000

ENV=development

INTERNAL_TOKEN=
