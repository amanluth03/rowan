# Copy to .env.local for local dev. Server-side only (read by Server
# Actions / Server Components / Route Handlers -- see src/lib/api/config.ts)
# -- never exposed to the browser, never prefixed NEXT_PUBLIC_.

# Base URL of the Rowan backend (backend/README.md's `uvicorn` quickstart).
ROWAN_API_BASE=http://localhost:8000

# Optional: display name shown in the sidebar (see app-shell.tsx's docstring
# on the missing organizations read model -- there's no live endpoint for
# this yet, so it's env-configured rather than fetched).
ROWAN_ORG_NAME=Rowan Demo Property Management

# --- Supabase Auth (Epic 1) ---
# Both are PUBLIC by design: the anon key is a client-side identifier
# constrained by Supabase RLS/policies, not a secret. NEVER put the
# service_role key in a NEXT_PUBLIC_ var (or in this app at all).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
